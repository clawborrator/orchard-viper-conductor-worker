# orchard-viper-conductor-worker environment.
#
# Copy to .env (gitignored) and fill in. `docker compose up -d` after
# changes — env_file is read at container creation, not on
# `docker compose restart`.
#
# Same env shape as orchard-viper-forum-worker. The conductor is
# strictly lighter: no Playwright, no cookies, no secrets mount.

# ─── Claude Code auth ──────────────────────────────────────────────────
# Pick ONE.

ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_ACCESS_TOKEN=

# The conductor's job is classification + delegation, light reasoning.
# sonnet is more than enough; haiku is fine if you want it cheap.
MODEL=sonnet

# ─── clawborrator hub binding ──────────────────────────────────────────

# Channel token minted via `claw token mint --name orchard-viper-conductor`.
# Written into /workspace/repo/.mcp.json at boot by the worker entrypoint.
CLAWBORRATOR_TOKEN=

CLAWBORRATOR_HUB_URL=wss://next.clawborrator.com

# Becomes @orchard-viper-conductor in the dashboard. Match the published
# agent handle's slug.
CLAWBORRATOR_ROUTING_NAME=orchard-viper-conductor

# ─── Agent code ────────────────────────────────────────────────────────

REPO_URL=https://github.com/clawborrator/orchard-viper-conductor-repo
REPO_REF=main
REPO_DIR_NAME=repo

# GitHub PAT with WRITE access to orchard-viper-conductor-repo for the
# self-improvement push loop. The agent edits its "## Learned" section
# and commits back. Without push access the agent still routes, but
# every routing-edge-case lesson is lost on container restart.
#
# Classic token: `repo` scope.
# Fine-grained token: Contents Read/Write on clawborrator/orchard-viper-conductor-repo.
REPO_PAT=
REPO_PAT_USER=x-access-token

# Identifiable agent identity in git log.
GIT_USER_EMAIL=agent@clawborrator.local
GIT_USER_NAME=orchard-viper-conductor (agent)

# ─── Agent boot ────────────────────────────────────────────────────────

# Initial prompt the entrypoint feeds Claude Code on first start. Tells
# the conductor to read its playbook and announce itself idle. No
# auth-check step here (unlike orchard-viper-forum) — the conductor has
# nothing local to check.
CLAUDE_INITIAL_PROMPT=Read /workspace/repo/CLAUDE.md carefully — that is your playbook. You are @MRIIOT/orchard-viper-conductor, a meta-agent that delegates Viper questions to @MRIIOT/orchard-viper (canonical) or @MRIIOT/orchard-viper-forum (community). Confirm you understand the decision rule, then idle and wait for inbound dispatches.

CLAUDE_SKIP_PERMISSIONS=1
DISABLE_AUTOENTER=0
